  "panels": [
    {
      "datasource": {
        "type": "postgres",
        "uid": "lume-ti"
      },
      "description": "Tokens over time by model using D50 dimensional paths with MAX-MIN usage over the window",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Tokens",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "spanNulls": false
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "lume-ti"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroupAlias(ts, 1h),\n  max(\"claude_code.token.usage.input.model.claude-sonnet@last\") - min(\"claude_code.token.usage.input.model.claude-sonnet@last\") AS \"claude-sonnet (input)\",\n  max(\"claude_code.token.usage.output.model.claude-sonnet@last\") - min(\"claude_code.token.usage.output.model.claude-sonnet@last\") AS \"claude-sonnet (output)\",\n  max(\"claude_code.token.usage.input.model.claude-opus@last\") - min(\"claude_code.token.usage.input.model.claude-opus@last\") AS \"claude-opus (input)\",\n  max(\"claude_code.token.usage.output.model.claude-opus@last\") - min(\"claude_code.token.usage.output.model.claude-opus@last\") AS \"claude-opus (output)\",\n  max(\"claude_code.token.usage.input.model.claude-haiku@last\") - min(\"claude_code.token.usage.input.model.claude-haiku@last\") AS \"claude-haiku (input)\",\n  max(\"claude_code.token.usage.output.model.claude-haiku@last\") - min(\"claude_code.token.usage.output.model.claude-haiku@last\") AS \"claude-haiku (output)\"\nFROM telemetry_agents\nWHERE $__timeFilter(ts)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Tokens Over Time by Model",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "lume-ti"
      },
      "description": "Cumulative cost for claude_code.cost.usage over time",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Cost (USD)",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "spanNulls": false
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "lume-ti"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroupAlias(ts, 1h),\n  vessel AS metric,\n  max(\"claude_code.cost.usage@last\") - min(\"claude_code.cost.usage@last\") AS \"claude_code.cost.usage\"\nFROM telemetry_agents\nWHERE $__timeFilter(ts)\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Cost (claude_code.cost.usage)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "lume-ti"
      },
      "description": "Active sessions per agent entity",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisColorMode": "text",
            "axisLabel": "Sessions",
            "axisPlacement": "auto",
            "fillOpacity": 80,
            "lineWidth": 1
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "lume-ti"
          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT\n  vessel AS entity,\n  count(DISTINCT ts) AS sessions\nFROM telemetry_agents\nWHERE $__timeFilter(ts)\nGROUP BY vessel\nORDER BY sessions DESC",
          "refId": "A"
        }
      ],
      "title": "Sessions per Entity",
      "type": "barchart"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "lume-ti"
      },
      "description": "Recent logbook documents from OTLP logs matching text search query $q",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ts_start"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 8
      },
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "ts_start"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "lume-ti"
          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT\n  title,\n  entity,\n  ts_start\nFROM docs\nWHERE match(body, '$q')\nORDER BY ts_start DESC\nLIMIT 100",
          "refId": "A"
        }
      ],
      "title": "Recent Logbook Docs",
      "type": "table"
    }
  ],
