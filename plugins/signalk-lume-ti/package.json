{
  "name": "signalk-lume-ti",
  "version": "0.16.1",
  "description": "Your boat's history and manuals, kept on the boat: records Signal K data, builds an offline library of cruising references, and answers questions about both.",
  "main": "index.js",
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-utility",
    "signalk-category-database"
  ],
  "signalk": {
    "appPath": "/signalk-lume-ti",
    "displayName": "Lume TI",
    "appIcon": "./icon.svg",
    "compatibility": ">=2.31.0"
  },
  "author": "DeepBlue Dynamics LLC",
  "homepage": "https://github.com/DeepBlueDynamics/lume/tree/main/plugins/signalk-lume-ti#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepBlueDynamics/lume.git",
    "directory": "plugins/signalk-lume-ti"
  },
  "bugs": {
    "url": "https://github.com/DeepBlueDynamics/lume/issues"
  },
  "license": "BSD-3-Clause",
  "scripts": {
    "test": "node test/run-tests.cjs",
    "prepack": "node lib/package-check.js"
  },
  "files": [
    "index.js",
    "lib/",
    "public/",
    "library/",
    "icon.*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "optionalDependencies": {
    "signalk-lume-ti-linux-arm64": "0.16.1",
    "signalk-lume-ti-linux-x64": "0.16.1"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ]
}
